# File: .env.example
# Purpose: Template for the variables docker-compose reads when bringing
# up the production stack. Copy to `.env` on the deployment host and
# replace every placeholder before running `docker compose up`.

# JWT secret. Generate something like 64 random characters:
#   openssl rand -base64 48
# Anyone who knows this can mint valid sessions, so treat it as a secret.
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Optional overrides for the seeded admin account. If left empty the
# seed creates the user as `admin` / `SSGG_admin_2410`.
ADMIN_EMAIL=admin
ADMIN_PASSWORD=SSGG_admin_2410

# Used by certbot in the bootstrap step (see README).
LETSENCRYPT_EMAIL=admin@carestino.com
