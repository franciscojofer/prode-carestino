# Servidor
PORT=3000
NODE_ENV=development

# JWT secret — cambiar en producción por una cadena aleatoria larga
JWT_SECRET=replace-with-a-long-random-string-in-production

# Base de datos SQLite (archivo relativo al directorio backend/)
DATABASE_URL="file:./prode.db"

# Cookies (true solo en producción con HTTPS)
COOKIE_SECURE=false

# Credenciales iniciales del admin (se usan en el seed)
ADMIN_EMAIL=admin
ADMIN_PASSWORD=SSGG_admin_2410
