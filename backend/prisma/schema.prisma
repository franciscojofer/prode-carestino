// File: backend/prisma/schema.prisma
// Purpose: Database schema for the Prode Carestino tournament app.
// Functionality: Defines users, login lockout state, teams, groups,
// tournament rounds, matches, predictions and a small key-value config table.
// Role: Single source of truth for the SQLite schema; Prisma generates both
// the migrations and the typed client used across the backend.
//
// Conventions:
// - All datetimes are stored in UTC. The frontend converts to Argentina
//   time (UTC-3) for display.
// - SQLite has no native enums; `Match.status` and `LoginAttempt.lockoutLevel`
//   are validated at the application layer.

generator client {
  provider      = "prisma-client-js"
  // Build the query engine for every musl/openssl combination we deploy to:
  //   - native:                          local dev (host arch).
  //   - linux-musl-arm64-openssl-3.0.x:  Docker on Apple Silicon / arm64 hosts.
  //   - linux-musl-openssl-3.0.x:        Docker on amd64 hosts (Lightsail, Railway).
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Application user. The seeded admin uses the literal email "admin" as a
// reserved login; everyone else uses a normal email.
model User {
  id            Int      @id @default(autoincrement())
  nombre        String
  apellido      String
  cuil          String   @unique
  email         String   @unique
  passwordHash  String
  isAdmin       Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  // Round from which the user starts accruing points (rule 4.7). Set to the
  // active round at the moment of registration.
  joinedRoundId Int?
  joinedRound   TournamentRound? @relation(fields: [joinedRoundId], references: [id])

  predictions  Prediction[]
  loginAttempt LoginAttempt?

  @@index([isActive])
}

// One row per user tracking failed-login attempts and the current lockout
// state. Maintained by the loginAttempt service (rule 4.9).
model LoginAttempt {
  userId       Int       @id
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  failedCount  Int       @default(0)
  lockedUntil  DateTime?
  // Increments each time the user hits MAX_ATTEMPTS. Resets to 0 only after
  // 24 h with no failures (never on a successful login).
  lockoutLevel Int       @default(0)
  lastFailedAt DateTime?
}

// National team. `nameEs` is the Argentine-Spanish display name.
model Team {
  id        Int    @id @default(autoincrement())
  nameEs    String
  code      String @unique
  flagEmoji String
  groupId   Int?
  group     Group? @relation(fields: [groupId], references: [id])

  homeMatches Match[] @relation("home")
  awayMatches Match[] @relation("away")
}

// Group stage container. The World Cup 2026 has 12 groups, A through L.
model Group {
  id    Int    @id @default(autoincrement())
  name  String @unique
  teams Team[]
}

// A round of the tournament. `orderIndex` is the canonical sort key used by
// the joinedRound comparison (rule 4.7) and the leaderboard filter.
model TournamentRound {
  id         Int       @id @default(autoincrement())
  name       String
  orderIndex Int       @unique
  startsAt   DateTime
  endsAt     DateTime?
  isKnockout Boolean   @default(false)

  // Matches originally scheduled for this round.
  matches        Match[]
  // Matches whose points actually count toward this round (may differ from
  // `matches` when the admin reschedules a postponed game — rule 4.5).
  countedMatches Match[] @relation("countsForRound")
  joinedUsers    User[]
}

// A single match. Result fields are nullable until the admin posts them.
model Match {
  id Int @id @default(autoincrement())

  // Round this match originally belongs to (immutable).
  roundId Int
  round   TournamentRound @relation(fields: [roundId], references: [id])

  // Round whose leaderboard the match contributes to. Defaults to roundId
  // and is editable by the admin when a match is moved (rule 4.5).
  countsForRoundId Int
  countsForRound   TournamentRound @relation("countsForRound", fields: [countsForRoundId], references: [id])

  homeTeamId Int
  homeTeam   Team @relation("home", fields: [homeTeamId], references: [id])
  awayTeamId Int
  awayTeam   Team @relation("away", fields: [awayTeamId], references: [id])

  // Current scheduled kickoff (may be rescheduled).
  scheduledAt DateTime
  // Actual kickoff timestamp (informational).
  kickoffAt   DateTime?

  // Score at the end of 120 minutes (penalties excluded — rule 4.1).
  homeGoals Int?
  awayGoals Int?

  isKnockout Boolean @default(false)

  // One of: scheduled | finished | postponed | cancelled.
  status String @default("scheduled")

  // When true the match awards 0 points to everyone, regardless of goals.
  // Used for admin overrides (rule 4.6).
  resolvedAdministratively Boolean @default(false)

  // If 120 min ended in a draw and the tie was broken by penalties, this
  // holds the winning team. The scoring engine uses it for the knockout
  // exception (rule 4.1).
  winnerByPenaltiesTeamId Int?

  // Human-readable slot label used by knockout fixtures whose actual
  // teams are not yet decided ("1A vs 3CEFHI", "W73 vs W75"). Stored
  // verbatim from the FIFA fixture so the admin can recognise the slot
  // when filling in the real teams via PATCH /admin/matches/:id.
  placeholderLabel String?

  predictions Prediction[]

  @@index([roundId])
  @@index([countsForRoundId])
  @@index([scheduledAt])
}

// A user's prediction for one match. Unique per (user, match).
// `pointsAwarded` and `isExact` are recomputed by the scoring engine each
// time the admin updates a match result.
model Prediction {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId       Int
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  homeGoals     Int
  awayGoals     Int
  pointsAwarded Int      @default(0)
  isExact       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, matchId])
  @@index([matchId])
}

// Simple key-value table for application-wide settings (e.g. tournament
// status flags). Kept intentionally small to avoid building a config UI.
model AppConfig {
  key   String @id
  value String
}
