// Schema Prisma — Prode Carestino Mundial 2026
//
// Convenciones:
// - Los nombres de modelos y campos siguen el prompt original (camelCase en JS, snake_case en DB no se usa aquí).
// - SQLite no soporta enums nativos: `status` y `lockoutLevel` se manejan como string/int validados en la app.
// - Todas las fechas se guardan en UTC. La conversión a UTC-3 (Argentina) se hace en el frontend.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  nombre        String
  apellido      String
  cuil          String   @unique
  email         String   @unique // funciona como username; el admin puede ser "admin"
  passwordHash  String
  isAdmin       Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  // Ronda desde la que el usuario suma puntos.
  // Al crearlo, se setea = ronda activa al momento del alta.
  joinedRoundId Int?
  joinedRound   TournamentRound? @relation(fields: [joinedRoundId], references: [id])

  predictions  Prediction[]
  loginAttempt LoginAttempt?

  @@index([isActive])
}

model LoginAttempt {
  userId       Int       @id
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  failedCount  Int       @default(0)
  lockedUntil  DateTime?
  // Se incrementa cada vez que se llega a 5 fallos consecutivos.
  // No se resetea con login exitoso; vuelve a 0 tras 24h sin actividad fallida.
  lockoutLevel Int       @default(0)
  lastFailedAt DateTime?
}

model Team {
  id          Int    @id @default(autoincrement())
  nameEs      String // "Argentina", "Bosnia-Herz.", "Países Bajos", etc.
  code        String @unique // "ARG", "BIH", "NED"
  flagEmoji   String // "🇦🇷"
  groupId     Int?
  group       Group? @relation(fields: [groupId], references: [id])

  homeMatches Match[] @relation("home")
  awayMatches Match[] @relation("away")
}

model Group {
  id    Int    @id @default(autoincrement())
  name  String @unique // "A", "B", "C"... "L" en Mundial 2026 (12 grupos)
  teams Team[]
}

model TournamentRound {
  id         Int       @id @default(autoincrement())
  name       String // "Fase de Grupos - Fecha 1", "Octavos", "Final", etc.
  orderIndex Int       @unique // 1..N — usado para comparaciones (>=) en joinedRound
  startsAt   DateTime
  endsAt     DateTime?
  isKnockout Boolean   @default(false)

  matches        Match[] // partidos originalmente programados en esta ronda
  countedMatches Match[] @relation("countsForRound") // partidos cuyos puntos cuentan acá (puede diferir si hubo postergación)
  joinedUsers    User[]
}

model Match {
  id Int @id @default(autoincrement())

  // Ronda original a la que pertenecía el partido (no cambia).
  roundId Int
  round   TournamentRound @relation(fields: [roundId], references: [id])

  // Ronda en la que efectivamente cuenta el partido para la tabla.
  // Por defecto igual a roundId; el admin puede modificarlo si un partido se reprograma.
  countsForRoundId Int
  countsForRound   TournamentRound @relation("countsForRound", fields: [countsForRoundId], references: [id])

  homeTeamId Int
  homeTeam   Team @relation("home", fields: [homeTeamId], references: [id])
  awayTeamId Int
  awayTeam   Team @relation("away", fields: [awayTeamId], references: [id])

  scheduledAt DateTime // horario actual del partido (puede haber sido modificado)
  kickoffAt   DateTime? // horario real de inicio (informativo)

  // Resultado de 120 minutos (sin penales).
  homeGoals Int?
  awayGoals Int?

  isKnockout Boolean @default(false)

  // scheduled | finished | postponed | cancelled
  status String @default("scheduled")

  // Si true, el partido no suma puntos a nadie aunque tenga resultado cargado.
  resolvedAdministratively Boolean @default(false)

  // Si los 120min terminaron empatados y se definió por penales, ID del equipo ganador.
  // Se usa en la regla de scoring (excepción de eliminatorias) para asignar 3 puntos
  // a quienes hayan predicho ese equipo.
  winnerByPenaltiesTeamId Int?

  predictions Prediction[]

  @@index([roundId])
  @@index([countsForRoundId])
  @@index([scheduledAt])
}

model Prediction {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId       Int
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  homeGoals     Int
  awayGoals     Int
  pointsAwarded Int      @default(0)
  isExact       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, matchId])
  @@index([matchId])
}

model AppConfig {
  key   String @id
  value String
}
